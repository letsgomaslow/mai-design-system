{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/badges/**",
              "components/cards/**",
              "components/forms/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|DM Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, DM Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|tagColor|title|blurb|cta|href|featured|key|ref|className|style|children)$/]",
        "message": "<CaseStudyCard> doesn't accept that prop. Declared props: tag, tagColor, title, blurb, cta, href, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:pillar|children|key|ref|className|style|children)$/]",
        "message": "<CategoryTag> doesn't accept that prop. Declared props: pillar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|onClick|key|ref|className|style|children)$/]",
        "message": "<CTAButton> doesn't accept that prop. Declared props: children, href, variant, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|ghost)$/]",
        "message": "<CTAButton> variant must be one of 'primary' | 'dark' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTALink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|key|ref|className|style|children)$/]",
        "message": "<CTALink> doesn't accept that prop. Declared props: children, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|type|placeholder|value|onChange|key|ref|className|style|children)$/]",
        "message": "<FormInput> doesn't accept that prop. Declared props: label, id, type, placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormTextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|placeholder|rows|value|onChange|key|ref|className|style|children)$/]",
        "message": "<FormTextArea> doesn't accept that prop. Declared props: label, id, placeholder, rows, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|logoHref|key|ref|className|style|children)$/]",
        "message": "<NavHeader> doesn't accept that prop. Declared props: links, active, logoHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|key|ref|className|style|children)$/]",
        "message": "<PillBadge> doesn't accept that prop. Declared props: children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|children|color|key|ref|className|style|children)$/]",
        "message": "<SectionEyebrow> doesn't accept that prop. Declared props: num, children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:offices|note|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: offices, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:stats|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: stats."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: children, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|headshotSrc|key|ref|className|style|children)$/]",
        "message": "<TestimonialBlock> doesn't accept that prop. Declared props: quote, attribution, headshotSrc."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
